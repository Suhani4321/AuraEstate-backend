# Django Email Configuration
# -------------------------------------------------------------
# If EMAIL_HOST_USER is blank, Django outputs emails cleanly to the console/terminal.
# To send REAL emails to actual agent inboxes:
# Set your SMTP host, your email, and your app password below.
# -------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Aura Luxury Real Estate <noreply@auraestate.in>
