# Django Email Configuration
# -------------------------------------------------------------
# By default without credentials, emails are logged to the console/terminal
# so you can test them immediately during development.
#
# To send real emails to agents' real inboxes (e.g. via Gmail SMTP):
# 1. Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
# 2. Fill in EMAIL_HOST_USER and EMAIL_HOST_PASSWORD below.
# -------------------------------------------------------------

# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Aura Luxury Real Estate <noreply@auraestate.in>
